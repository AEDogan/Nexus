{
  "appId": "com.nexus.launcher",
  "productName": "NEXUS",
  "copyright": "Copyright © 2026 NEXUS",
  "directories": {
    "output": "release",
    "buildResources": "public"
  },
  "compression": "maximum",
  "asar": true,
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/**/*",
    "!**/*.ts",
    "!**/*.map"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "public/nexus_icon.ico",
    "artifactName": "${productName}-Setup-${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "NEXUS",
    "installerIcon": "public/nexus_icon.ico",
    "uninstallerIcon": "public/nexus_icon.ico",
    "installerHeaderIcon": "public/nexus_icon.ico",
    "uninstallDisplayName": "${productName}",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true
  }
}
